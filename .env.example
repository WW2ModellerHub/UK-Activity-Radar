NETWORK_RAIL_USERNAME=
NETWORK_RAIL_PASSWORD=
NETWORK_RAIL_ENABLED=true
DEMO_MODE=false
# Hide local diagnostic/bulk debug routes when exposing the service publicly.
PUBLIC_DEPLOYMENT=false
# Automatically true on public deployments. This hard-disables sources whose
# published terms do not support a paid/commercial service.
COMMERCIAL_MODE=false
PUBLIC_TILE_REQUESTS_PER_MINUTE=240
PUBLIC_TILE_GLOBAL_PER_MINUTE=1200
PUBLIC_LOOKUP_REQUESTS_PER_MINUTE=60
PUBLIC_LOOKUP_GLOBAL_PER_MINUTE=300
# Local prototype analytics only. Keep false on a public deployment until a
# consent flow and an operator-only reporting endpoint exist.
PRODUCT_ANALYTICS_ENABLED=false
# Browser map delivery cadence. Provider feeds retain their own safe limits.
WEBSOCKET_REFRESH_SECONDS=1.0

# Live feed topics
NETWORK_RAIL_HOST=publicdatafeeds.networkrail.co.uk
NETWORK_RAIL_PORT=61618
NETWORK_RAIL_TRUST_TOPIC=/topic/TRAIN_MVT_ALL_TOC
NETWORK_RAIL_TD_TOPIC=/topic/TD_ALL_SIG_AREA
NETWORK_RAIL_VSTP_TOPIC=/topic/VSTP_ALL
TD_ENABLED=true
VSTP_ENABLED=true

# Background data preparation
AUTO_SYNC_SCHEDULE=true
AUTO_SYNC_REFERENCE=true
REFRESH_SCHEDULE=false
REFRESH_REFERENCE_DATA=false
NETWORK_RAIL_CLIENT_ID=uk-activity-radar-dev

# Optional multimodal routing. This must point at an independently deployed
# OpenTripPlanner 2 GTFS GraphQL service with its own OSM + GTFS/NeTEx graph.
# Leave blank to keep journey planning unavailable rather than inventing routes.
OTP_GRAPHQL_URL=
OTP_TIMEOUT_SECONDS=12
# Uses the existing TomTom key for driving, walking and cycling routes.
TOMTOM_ROUTING_ENABLED=true

# DfT Bus Open Data Service — free/open live GPS
BODS_ENABLED=true
# Use the free Data Consumer API key from your BODS Account settings.
# If left blank, the app falls back to the public bulk SIRI-VM snapshot.
BODS_API_KEY=
BODS_BULK_URL=https://data.bus-data.dft.gov.uk/avl/download/bulk_archive
BODS_API_URL=https://data.bus-data.dft.gov.uk/api/v1/gtfsrtdatafeed/
BODS_DISRUPTIONS_URL=https://data.bus-data.dft.gov.uk/api/v1/siri-sx
BODS_CANCELLATIONS_URL=https://data.bus-data.dft.gov.uk/api/v1/siri-sx/cancellations
BODS_SX_ENABLED=true
BODS_SX_POLL_SECONDS=60
BODS_POLL_SECONDS=15
BODS_MAX_AGE_SECONDS=300
# To keep the browser responsive, national zoom shows only Cool-priority trains;
# routine trains and bus dots appear after zooming in.
TRAIN_MIN_MAP_ZOOM=7
TRAIN_MAX_STREAM=2000
BUS_MIN_MAP_ZOOM=7
BUS_MAX_STREAM=2500

# National Highways Road & Lane Closures v2.0 — free account/subscription key
NATIONAL_HIGHWAYS_ENABLED=true
NATIONAL_HIGHWAYS_API_KEY=
NATIONAL_HIGHWAYS_BASE_URL=https://api.data.nationalhighways.co.uk/roads/v2.0
NATIONAL_HIGHWAYS_POLL_SECONDS=60
# false = unplanned/current disruptions only; true also pulls planned closures
NATIONAL_HIGHWAYS_INCLUDE_PLANNED=true
NATIONAL_HIGHWAYS_VMS_ENABLED=false
# Paste the full GET operation URL shown by your Digital VMS subscription.
NATIONAL_HIGHWAYS_VMS_URL=
NATIONAL_HIGHWAYS_SPEED_ENABLED=false
NATIONAL_HIGHWAYS_SPEED_URL=https://api.data.nationalhighways.co.uk/sma/v1.0/speedManagedAreas
NATIONAL_HIGHWAYS_SPEED_POLL_SECONDS=120
# Static, opt-in Network layer. Poll slowly to respect the shared 10 calls/minute limit.
NATIONAL_HIGHWAYS_FEATURES_ENABLED=false
NATIONAL_HIGHWAYS_FEATURES_URL=https://api.data.nationalhighways.co.uk/rlf/v1.0/roadLimitsAndFeatures
NATIONAL_HIGHWAYS_FEATURE_TYPES=emergencyTelephone,busStop
NATIONAL_HIGHWAYS_FEATURES_POLL_SECONDS=3600

# DfT Street Manager local roadworks open data. This is an official signed SNS
# push feed, not a polled API. After deploying HTTPS, enable this and register:
# https://YOUR-DOMAIN/api/integrations/street-manager
STREET_MANAGER_ENABLED=false
# Safe when signatures validate and the official SNS URL allow-list matches.
STREET_MANAGER_AUTO_CONFIRM=true

# Environment Agency current flood warnings/alerts — free, no account/key
EA_FLOODS_ENABLED=true
EA_FLOODS_URL=https://environment.data.gov.uk/flood-monitoring/id/floods
EA_FLOOD_AREAS_URL=https://environment.data.gov.uk/flood-monitoring/id/floodAreas
EA_FLOODS_POLL_SECONDS=300


# AISStream maritime tracking — local/private development only until written
# commercial redistribution permission is in place. COMMERCIAL_MODE forces off.
AISSTREAM_ENABLED=true
AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# Optional JSON override; default covers UK/Ireland + nearby waters
AISSTREAM_BOUNDING_BOXES=
MARITIME_MIN_MAP_ZOOM=6
MARITIME_MAX_STREAM=1800


# Free/open ADSB.lol public-service/SAR aircraft layer — no key required
ADSB_SAR_ENABLED=true
ADSB_LOL_BASE_URL=https://api.adsb.lol
# One UK region per request: 30s gives a full four-region refresh in about 2 min.
ADSB_SAR_POLL_SECONDS=12

# RNLI launch content — local/private development only; COMMERCIAL_MODE forces off.
RNLI_ENABLED=true
RNLI_LAUNCHES_URL=https://services.rnli.org/api/launches
RNLI_POLL_SECONDS=120


# London Fire Brigade page collector — COMMERCIAL_MODE forces off.
LONDON_FIRE_ENABLED=true
LONDON_FIRE_URL=https://www.london-fire.gov.uk/incidents/?initialLoad=True
LONDON_FIRE_POLL_SECONDS=180

# Related coverage — GDELT discovery + normal X/news search links, no paid API
COVERAGE_ENABLED=true
GDELT_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Met Office severe-weather warnings via a public mirror — COMMERCIAL_MODE forces off.
# This mirror can lag official warnings; cards always link to the Met Office.
MET_OFFICE_ENABLED=true
MET_OFFICE_ARCGIS_ITEM=23e51204bd3348f1a37b50786b8abdea
MET_OFFICE_POLL_SECONDS=900

# Public Nominatim is not used by the commercial deployment. TomTom search is
# used instead. Commons imagery is shown only with its per-file source/licence.
NOMINATIM_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
WIKIMEDIA_ENABLED=true
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php

# TomTom traffic + UK place/road search. Keep the key server-side; the app proxies traffic tiles and search through FastAPI.
TRAFFIC_FLOW_ENABLED=true
TOMTOM_TRAFFIC_API_KEY=
TOMTOM_TRAFFIC_BASE_URL=https://api.tomtom.com
TRAFFIC_FLOW_CACHE_SECONDS=45
TRAFFIC_FLOW_CACHE_MAX_TILES=512
TRAFFIC_FLOW_TIMEOUT_SECONDS=12
MAP_TILE_CACHE_SECONDS=86400
MAP_TILE_CACHE_MAX_TILES=2048

# ---------- optional Radar+ billing ----------
# Leave disabled for local development. Production requires all Stripe values,
# an HTTPS public URL, and a long random pepper kept outside Git.
BILLING_ENABLED=false
PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
BILLING_TOKEN_PEPPER=
RADAR_PLUS_PRICE_DISPLAY=£3.99/month
SELLER_LEGAL_NAME=
SUPPORT_EMAIL=
MIN_FREE_DISK_MB=1024

# ---------- proactive commute alerts ----------
# Web Push works only on the hosted HTTPS service. Generate one VAPID keypair,
# keep the private key secret, and do not rotate it while subscriptions exist.
PUSH_ALERTS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
PUSH_POLL_SECONDS=90

# ---------- v1.2 additional free/open live layers ----------
# British Geological Survey recent UK earthquakes — local/private profile only.
# COMMERCIAL_MODE forces this off until separate commercial display permission
# has been confirmed for the feed.
BGS_EARTHQUAKES_ENABLED=true
BGS_EARTHQUAKES_URL=https://quakes.bgs.ac.uk/feeds/MhSeismology.xml
BGS_EARTHQUAKES_POLL_SECONDS=300

# Environment Agency tide gauges only in the UI (ordinary river-level markers are suppressed)
EA_LEVELS_ENABLED=true
EA_STATIONS_URL=https://environment.data.gov.uk/flood-monitoring/id/stations
EA_READINGS_URL=https://environment.data.gov.uk/flood-monitoring/data/readings?latest
EA_LEVELS_POLL_SECONDS=900
EA_LEVELS_MAX_POINTS=1200

# Cefas WaveNet near-live wave buoys
WAVENET_ENABLED=true
WAVENET_MAP_URL=https://wavenet.cefas.co.uk/map
WAVENET_POLL_SECONDS=1800
WAVENET_MAX_SITES=60

# NESO regional grid carbon intensity
CARBON_INTENSITY_ENABLED=true
CARBON_INTENSITY_URL=https://api.carbonintensity.org.uk/regional
CARBON_INTENSITY_POLL_SECONDS=1800

# DEFRA UK-AIR regional air quality
UK_AIR_ENABLED=true
UK_AIR_BASE_URL=https://uk-air.defra.gov.uk/latest/measurement-summary-map
UK_AIR_POLL_SECONDS=3600

# TfL live cycle hire (no key required; optional key supported)
TFL_LIVE_ENABLED=true
TFL_API_BASE=https://api.tfl.gov.uk
TFL_APP_KEY=
TFL_POLL_SECONDS=120

# UK shared bikes/scooters via open GBFS directory
GBFS_ENABLED=true
GBFS_SYSTEMS_URL=https://raw.githubusercontent.com/MobilityData/gbfs/master/systems.csv
GBFS_POLL_SECONDS=300
GBFS_MAX_SYSTEMS=12
GBFS_MAX_POINTS=1500

# NOAA aurora/space-weather trigger
SPACE_WEATHER_ENABLED=true
NOAA_KP_URL=https://services.swpc.noaa.gov/json/planetary_k_index_1m.json
NOAA_AURORA_URL=https://services.swpc.noaa.gov/json/ovation_aurora_latest.json
SPACE_WEATHER_POLL_SECONDS=300

# ISS position derived live from free CelesTrak orbital elements
ISS_ENABLED=true
ISS_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?CATNR=25544&FORMAT=TLE
ISS_POLL_SECONDS=20
ISS_TLE_REFRESH_SECONDS=21600

# Open electricity-distribution outage feeds
POWER_OUTAGES_ENABLED=true
NGED_POWERCUTS_URL=https://connecteddata.nationalgrid.co.uk/dataset/d6672e1e-c684-4cea-bb78-c7e5248b62a2/resource/a1365982-4e05-463c-8304-8323a2ba0ccd/download/live_detailed_power_cuts.csv
SSEN_OUTAGE_METADATA_URL=https://ckan-prod.sse.datopian.com/dataset/real_time_outage.jsonld
POWER_OUTAGES_POLL_SECONDS=900

# Traffic Scotland official winter gritter tracker (seasonal)
GRITTER_ENABLED=true
GRITTER_ARCGIS_ITEM=a256a6b57fa440daa50fc2974d80f219
GRITTER_POLL_SECONDS=120

# Keep aviation focused: SAR/HEMS + military/special-interest only, not general flights
INTERESTING_AIRCRAFT_ENABLED=true

# Optional official DATEX endpoints if/when registered/approved access is supplied.
TRAFFIC_SCOTLAND_DATEX_URL=
TRAFFIC_WALES_DATEX_URL=
# Reserved for compatibility only. National Highways NTIS real-time DATEX is a
# subscriber-to-subscriber SOAP push service, not a public URL this release can
# poll. Supplying a guessed endpoint here does not enable an NTIS feed.
NTIS_DATEX_URL=
